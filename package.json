{
  "name": "editandoideas-apiemail",
  "version": "1.0.0",
  "private": true,
  "description": "API de envio de correos (Resend) para los sitios de clientes de Editando Ideas — apiemail.editandoideas.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "key:new": "node scripts/new-key.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
