PORT=8080
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente por defecto (dominio verificado en Resend) para sitios sin "from" propio.
DEFAULT_FROM_ADDRESS=no-reply@editandoideas.com
# Registro de sitios: archivo (por defecto) o JSON completo en variable (Secret Manager en Cloud Run).
SITES_FILE=config/sites.json
# SITES_JSON=
TRUST_PROXY=1
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_SITE_PER_HOUR=100
# Secrets de Cloudflare Turnstile, uno por sitio que lo active (turnstileSecretEnv en sites.json).
# TURNSTILE_SECRET_MODULAX=
# TURNSTILE_SECRET_EDITANDOIDEAS=
# Secret keys de Google reCAPTCHA, una por sitio que lo active (recaptchaSecretEnv en sites.json).
# RECAPTCHA_SECRET_MODULAX=
